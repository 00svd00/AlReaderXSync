    <!-- ============================================================
         Mode help
         %1$s — target, %2$s — source
         ============================================================ -->
    <string name="mode_replace_help">
        Replace mode\n\n
        Makes the contents of %1$s match the contents of %2$s exactly.\n\n
        How it works:\n
        1. Both directories are scanned.\n
        2. Files are compared by name and size.\n
        3. Files missing on %1$s are transferred.\n
        4. Files with matching name and size are skipped.\n
        5. Files that differ are re-transferred.\n
        6. Files on %1$s that don\'t exist on %2$s are deleted.\n\n
        Note: files deleted on %2$s will also be deleted on %1$s.
    </string>

    <string name="mode_merge_help">
        Merge mode\n\n
        Adds files from %2$s to %1$s, without deleting existing ones.\n\n
        How it works:\n
        1. Both directories are scanned.\n
        2. Files are compared by name and size.\n
        3. Files missing on %1$s are transferred.\n
        4. Matching files are skipped.\n
        5. Files that differ are re-transferred.\n
        6. Extra files on %1$s are kept.\n\n
        Note: if %1$s has files that were deleted on %2$s, they will remain.
        Over time this may accumulate "garbage". Use Replace mode to clean up.
    </string>

    <!-- ============================================================
         Direction help
         %1$s — source, %2$s — target
         ============================================================ -->
    <string name="direction_help">
        Sync direction\n\n
        Determines which device sends files to which.\n\n
        Selected direction:\n
        • Source: %1$s\n
        • Target: %2$s\n\n
        What this means:\n
        • Files are transferred from %1$s to %2$s.\n
        • If a file exists on %1$s but not on %2$s, it will be transferred.\n
        • If a file exists on both but differs in size, it will be re-transferred.\n
        • If a file exists on both and matches by name and size, it is skipped.\n\n
        Important: direction is set on the phone. The reader always works as a server and executes the phone\'s command.
    </string>

