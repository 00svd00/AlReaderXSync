<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран настроек.
    ВАЖНО: НЕТ android:fitsSystemWindows.
    WindowInsets обрабатываются на settingsRoot
    (top + bottom), см. SettingsActivity.applyWindowInsets().
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ============================================================
         Toolbar с кнопкой «Назад» (setDisplayHomeAsUpEnabled)
         ============================================================ -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/settings_title"
        app:titleTextColor="@android:color/white" />

    <!-- ============================================================
         Скроллируемая часть — содержимое настроек
         ============================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- РОЛЬ УСТРОЙСТВА -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_role"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginTop="8dp" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/role_phone" />

                <RadioButton
                    android:id="@+id/rbReader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/role_reader" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20000000"
                android:layout_marginTop="16dp" />

            <!-- КАТАЛОГИ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_directories"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnSelectAlreader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/select_alreader" />

            <TextView
                android:id="@+id/tvAlreaderPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:text="AlReaderX: не выбран" />

            <Button
                android:id="@+id/btnSelectBooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/select_books" />

            <TextView
                android:id="@+id/tvBooksPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:text="Books: не выбран" />

            <CheckBox
                android:id="@+id/cbBooksInsideAlreader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/books_inside_alreader" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20000000"
                android:layout_marginTop="16dp" />

            <!-- ТРАНСПОРТ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_transport"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginTop="16dp" />

            <RadioGroup
                android:id="@+id/rgTransportMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbTransportAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transport_auto" />

                <RadioButton
                    android:id="@+id/rbTransportBluetoothOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transport_bluetooth_only" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20000000"
                android:layout_marginTop="16dp" />

            <!-- РЕТРАИ И ТАЙМАУТЫ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_retries"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wi-Fi LAN:" />

                <EditText
                    android:id="@+id/etWifiLanRetries"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:gravity="end"
                    android:maxLength="2"
                    android:text="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" × "
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etWifiLanTimeoutSec"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:gravity="end"
                    android:maxLength="2"
                    android:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" сек"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bluetooth:" />

                <EditText
                    android:id="@+id/etBluetoothRetries"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:gravity="end"
                    android:maxLength="2"
                    android:text="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" × "
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etBluetoothTimeoutSec"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:gravity="end"
                    android:maxLength="2"
                    android:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" сек"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20000000"
                android:layout_marginTop="16dp" />

            <!-- СОСТОЯНИЕ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_state"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi-Fi: —"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IP: —"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvBtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bluetooth: —"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnCheckTransports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/check_transports" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20000000"
                android:layout_marginTop="16dp" />

            <!-- ДОПОЛНИТЕЛЬНО -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_advanced"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:layout_marginTop="16dp" />

            <!-- Явное сохранение всех настроек -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/save_settings" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
